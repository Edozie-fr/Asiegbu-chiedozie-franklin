  <script>
    // ── Scroll reveal ──
    const reveals = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry, i) => {
        if (entry.isIntersecting) {
          setTimeout(() => entry.target.classList.add('visible'), i * 80);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    reveals.forEach(el => observer.observe(el));

    // ── Profile photo upload ──
    const profileInput   = document.getElementById('profileInput');
    const profilePreview = document.getElementById('profilePreview');
    const profilePlaceholder = document.getElementById('profilePlaceholder');
    const profileWrap    = document.getElementById('profileWrap');
    const profileRemoveBtn = document.getElementById('profileRemoveBtn');
    const photoHint      = document.querySelector('.photo-hint');

    profileInput.addEventListener('change', function () {
      const file = this.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (e) => {
        profilePreview.src = e.target.result;
        profilePreview.style.display = 'block';
        profilePlaceholder.style.display = 'none';
        profileWrap.classList.add('has-photo');
        profileRemoveBtn.style.display = 'inline-flex';
        photoHint.textContent = 'Click to change photo';
      };
      reader.readAsDataURL(file);
    });

    function removeProfilePhoto() {
      profilePreview.src = '';
      profilePreview.style.display = 'none';
      profilePlaceholder.style.display = 'flex';
      profileWrap.classList.remove('has-photo');
      profileRemoveBtn.style.display = 'none';
      photoHint.textContent = 'Click to upload profile photo';
      profileInput.value = '';
    }

    // ── Gallery upload ──
    const galleryInput = document.getElementById('galleryInput');
    const galleryGrid  = document.getElementById('galleryGrid');
    const galleryEmpty = document.getElementById('galleryEmpty');
    let galleryCount = 0;

    galleryInput.addEventListener('change', function () {
      addImages([...this.files]);
      this.value = '';
    });

    function addImages(files) {
      files.forEach(file => {
        if (!file.type.startsWith('image/')) return;
        const reader = new FileReader();
        reader.onload = (e) => {
          if (galleryEmpty) galleryEmpty.style.display = 'none';
          galleryCount++;
          const id = 'gimg-' + galleryCount;
          const item = document.createElement('div');
          item.className = 'gallery-item';
          item.id = id;
          const shortName = file.name.length > 22 ? file.name.slice(0, 20) + '…' : file.name;
          item.innerHTML = `
            <img src="${e.target.result}" alt="${file.name}" loading="lazy"/>
            <div class="gallery-item-overlay">
              <span class="gallery-item-name">${shortName}</span>
              <button class="gallery-delete-btn" onclick="deleteGalleryItem('${id}')" title="Remove">✕</button>
            </div>`;
          galleryGrid.appendChild(item);
        };
        reader.readAsDataURL(file);
      });
    }

    function deleteGalleryItem(id) {
      const el = document.getElementById(id);
      if (el) {
        el.style.opacity = '0';
        el.style.transform = 'scale(0.85)';
        el.style.transition = 'opacity 0.25s, transform 0.25s';
        setTimeout(() => {
          el.remove();
          if (!galleryGrid.querySelector('.gallery-item')) {
            galleryEmpty.style.display = 'block';
          }
        }, 250);
      }
    }

    // Drag & drop support
    function handleDragOver(e) {
      e.preventDefault();
      document.getElementById('galleryZone').classList.add('drag-over');
    }
    function handleDragLeave(e) {
      document.getElementById('galleryZone').classList.remove('drag-over');
    }
    function handleDrop(e) {
      e.preventDefault();
      document.getElementById('galleryZone').classList.remove('drag-over');
      addImages([...e.dataTransfer.files]);
    }
  </script>
